  },
  {
    "id": "L09",
    "narration": "AI 根据每一页的文字，先安排组件、动效、素材和音效。",
    "pauseAfter": 0.15
  },
  {
    "id": "L10",
    "narration": "人再进工作台微调位置、字号、颜色和节奏。",
    "pauseAfter": 0.18
