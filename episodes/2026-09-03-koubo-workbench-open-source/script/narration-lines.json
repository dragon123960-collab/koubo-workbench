[
  {
    "id": "L01",
    "narration": "做口播视频，最累的其实不是写文案。",
    "pauseAfter": 0.15
  },
  {
    "id": "L02",
    "narration": "是每一句话，到底该配什么画面。",
    "pauseAfter": 0.2
  },
  {
    "id": "L03",
    "narration": "什么时候上字幕，什么时候出列表，什么时候给一个音效。",
    "pauseAfter": 0.15
  },
  {
    "id": "L04",
    "narration": "如果全靠手动拖，最后就很容易变成 PPT 拼图。",
    "pauseAfter": 0.25
  },
  {
    "id": "L05",
    "narration": "所以我们做了一个口播动效工作台。",
    "pauseAfter": 0.18
  },
  {
    "id": "L06",
    "narration": "它的起点不是空白画布，而是一份已经整理好的工作台 JSON。",
    "pauseAfter": 0.18
  },
  {
    "id": "L07",
    "narration": "前面先写文字稿，再生成配音。",
    "pauseAfter": 0.12
  },
  {
    "id": "L08",
    "narration": "然后用 Whisper 这一类工具，把配音解析成逐字时间戳。",
